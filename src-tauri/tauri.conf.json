{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Bellwake",
	"version": "0.1.0",
	"identifier": "com.bellwake.agent",
	"build": {
		"beforeDevCommand": "npm run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "npm run build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "Bellwake",
				"visible": false,
				"width": 800,
				"height": 600,
				"center": true,
				"closable": false,
				"maximizable": false,
				"minimizable": false,
				"resizable": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
	}
}

# Bellwake Bootstrap Relay
#
# Этот ключ является общим для всех организаций, использующих
# официальный Bellwake Cloudflare Relay.
#
# НЕ ГЕНЕРИРОВАТЬ новый ключ для каждой установки.
# НЕ МЕНЯТЬ его при использовании официального Relay:
#
# https://bellwake-relay.ovsyannikov-ivan.workers.dev
#
# Если используется собственный Cloudflare Worker,
# RELAY_SEND_TOKEN необходимо заменить одновременно:
#   1. здесь / в .env backend;
#   2. в secret собственного Cloudflare Worker.
#
RELAY_SEND_TOKEN=01c1b649e5189bbf57dbc83b8694d2375b980a5b2af6d1c8e158b1067ca13887

# Домен
BELLWAKE_DOMAIN=bellwake.example.org

# Уникальный секрет конкретной организации.
# setup-env.sh генерирует его при первоначальной установке.
ENROLLMENT_TOKEN=

# API
HOST=127.0.0.1
PORT=3102

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bellwake
DB_USER=bellwake
DB_PASSWORD=change-me

# MQTT
MQTT_LOCAL_PORT=1883
MQTT_PORT=8883
MQTT_TOPIC=bellwake/notifications
MQTT_SESSION_EXPIRATION=90d

MQTT_ADMIN_USER=bellwake-admin
MQTT_ADMIN_PASSWORD=

MQTT_PUBLISHER_USER=bellwake-server
MQTT_PUBLISHER_PASSWORD=

MQTT_AGENT_USER=bellwake-agent
MQTT_AGENT_PASSWORD=
